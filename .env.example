# ============================================================
# Elysia Chat 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# 后端 API 地址（开发环境默认本地，生产环境改为实际域名）
VITE_API_BASE_URL=http://localhost:3000

# API 认证密钥（用于请求签名/验证，请替换为你的实际密钥）
VITE_API_SECRET=

# 角色 ID（对应后端配置的 AI 角色标识）
VITE_CHARACTER_ID=

